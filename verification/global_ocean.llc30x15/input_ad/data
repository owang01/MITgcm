# ====================
# | Model parameters |
# ====================
#
# LLC30 adjoint experiment (Phase B, code_ad/input_ad) -- starts from
# Phase A's forward input/data (see HANDOFF.md), kept IDENTICAL to it
# for every physics/numerics parameter (2026-11-14: confirmed real
# V4r6's own adjoint run, Time-invariant-adjoint/v4r6/
# run_local_adjv6_140_noseaicead/data, differs from its forward data
# ONLY in nTimeSteps -- no separate adjoint-specific viscosity/
# diffusivity/solver tuning. The earlier cs32x15/code_ad-style
# convention of a separate cg2dTargetResidual=1.E-9 "for AD-gradient
# agreement" was a code_ad-template precedent, not a real V4r6
# practice, and has been dropped here to match V4r6's own approach).
# Only the genuinely AD-specific additions remain: nTimeSteps (short
# smoke test), adjMonitorFreq/adjDumpFreq (ADM gradient-check output).
#
# Continuous equation parameters
 &PARM01
#-- tRef/sRef remapped from real V4r6 production values (50-level
#   tRef/sRef in Time-invariant-adjoint/v4r6/input.V4r6.102/data's PARM01)
#   via preprocess/coarsen_initial_ts_to_llc30.py's depth-weighted overlap
#   remap onto this config's own 15-level delR (see that script and
#   preprocess/README.md's "Initial condition" section) -- replaces the
#   previous flat analytic tRef=15*20./sRef=15*35. now that a real
#   hydrogThetaFile/hydrogSaltFile (PARM05 below) supplies the actual 3-D
#   initial state; tRef/sRef only matter at dry cells once those are set.
#   sRef remaps to exactly flat 34.5 since production sRef is itself flat.
 tRef= 22.6000,19.7170,15.0626,11.0093,8.2365,6.0819,4.5794,3.5163,2.3917,1.8283,1.0000,1.0000,1.0000,1.0000,1.0000,
 sRef=15*34.5,
#-- 2026-11-12 fix: viscAh=3.E5 (flat) was inherited unexamined from
#   global_ocean.cs32x15's near-uniform ~310km cubed-sphere grid and was
#   the real root cause of a deltaT=3600s CFL instability on LLC30's own
#   grid, which (inherited from LLC90's pole/facet geometry via the 3:1
#   coarsening) ranges over >100x in cell size (2.7km-333km, confirmed
#   via run/DXF.data/DYF.data) -- a flat viscAh is systematically wrong
#   for a grid this non-uniform. Switched to real V4r6's own scheme
#   (input.V4r6.102/data): viscAh=1.0 (near-negligible flat term) +
#   viscAhGrid=2.E-2 (grid-AREA-scaled Laplacian viscosity,
#   Alin=viscAhGrid*L^2/deltaT per pkg/mom_common/mom_calc_visc.F --
#   automatically larger on LLC30's biggest cells, smaller on its
#   smallest, exactly the self-scaling behavior this grid needs; also
#   automatically ~9x larger on LLC30's cells than on LLC90's own cells
#   at the same location, the physically appropriate direction for a
#   3x-coarser grid). Verified on the FORWARD config: full 30-day/
#   720-step deltaT=3600s test (real bathy+pickup) reaches STOP NORMAL
#   END on all 13 ranks, zero NaN -- see HANDOFF.md's "RESOLVED: LLC30's
#   timestep ceiling" section for the full investigation.
 viscAh =1.E0,
 viscAhGrid=2.E-2,
#-- viscAr: real V4r6's own value (0.5E-4), down from this config's
#   previously-inherited cs32x15 value (1.E-3) -- no grid-area-scaling
#   mechanism exists for vertical viscosity, so adopted as a flat copy;
#   confirmed compatible with LLC30's 15-level delR (vs. V4r6's 50) on
#   the forward config's 30-day verification run.
 viscAr =0.5E-4,
#-- diffKrT/diffKrS: adopted real V4r6's value (1.E-5), down from this
#   config's previously-inherited cs32x15 value (3.E-5). Unlike viscAh,
#   this is NOT a resolution-driven stability concern: diffKr*deltaT/dz^2
#   (the explicit vertical-diffusion stability ratio) is ~1.4E-5 at
#   diffKr=1.E-5 on LLC30's thinnest (50m) level at deltaT=3600s --
#   ~35,000x below the ~0.5 instability threshold at EITHER value, since
#   LLC30's vertical layers (50-1480m) are far thicker in absolute terms
#   than its horizontal cells can be (down to 2.7km) -- so dz^2
#   dominates the denominator regardless.
 diffKrT=1.E-5,
 diffKrS=1.E-5,
#-- diffKhT/diffKhS: real V4r6's value (1.E1), ADDED here -- LLC30
#   previously set no horizontal tracer diffusivity at all (implicitly
#   0, never inherited from cs32x15 either -- a pure omission, not a
#   wrong-value case). Checked: diffKh*dt/L^2 (horizontal diffusive
#   stability ratio) is ~1.3E-5 even on LLC30's smallest (2.7km) cells
#   at this value -- far below the ~0.5 instability threshold.
 diffKhT=1.E1,
 diffKhS=1.E1,
 ivdc_kappa=10.,
#-- Task 6 fix: pkg/ggl90/ggl90_check.F hard-requires implicitViscosity
#   (STOP 'ABNORMAL END: S/R GGL90_CHECK' otherwise); implicitDiffusion
#   alone (already set below) is not sufficient for GGL90's vertical
#   viscosity term.
 implicitViscosity=.TRUE.,
 implicitDiffusion=.TRUE.,
 gravity=9.81,
#-- rhoConst: adopted real V4r6's value (1029.), down from this
#   config's previously-inherited cs32x15 value (1035.) -- a pure
#   physical constant for the Boussinesq approximation, no
#   resolution-dependence mechanism applies.
 rhoConst=1029.,
 rhoConstFresh=1000.,
 eosType='JMD95Z',
 staggerTimeStep=.TRUE.,
 vectorInvariantMomentum=.TRUE.,
 implicitFreeSurface=.TRUE.,
 exactConserv=.TRUE.,
 select_rStar=2,
 nonlinFreeSurf=4,
 hFacInf=0.2,
 hFacSup=2.0,
 useRealFreshWaterFlux=.TRUE.,
#-- Phase A (adjoint-experiment plan, see HANDOFF.md): now that
#   pkg/seaice is compiled, model/src/config_check.F forbids
#   allowFreezing=.TRUE. together with useSEAICE (seaice handles
#   freezing physics itself) -- confirmed real V4r6 also sets this
#   .FALSE. (input.V4r6.102/data).
 allowFreezing=.FALSE.,
#-- no_slip_sides/no_slip_bottom + bottomDragQuadratic: adopted real
#   V4r6's values (previously LLC30 defaulted to free-slip + no bottom
#   drag, inherited un-set from cs32x15). Physical boundary-condition
#   choices, not resolution-coupled numerics; already confirmed on the
#   forward config that no_slip alone has ZERO effect on the
#   deltaT=3600s CFL instability.
 no_slip_sides=.TRUE.,
 no_slip_bottom=.TRUE.,
 bottomDragQuadratic=0.001,
#-- hFacMinDr raised 20->30 (paired with the viscosity fix above, same
#   as the forward config -- see ini_masks_etc.F's rStarFacW/S).
#-- hFacMin: adopted real V4r6's value (.2), up from this config's
#   previously-inherited cs32x15 value (.1). UNLIKE the other params
#   adopted this session, this one IS genuinely resolution-coupled:
#   hFacMin combines via MAX() with hFacMinDr/drF(k) in
#   ini_masks_etc.F, and on LLC30's much-thicker vertical layers
#   (50-1480m vs V4r6's 10-242m), hFacMin itself becomes the binding
#   floor from level 5 (~190m) downward. Regenerated hFac*.data + the
#   pickup file to match (same procedure as the forward config).
 hFacMin=.2,
 hFacMinDr=30.,
#-- LLC30 bathymetry (preprocess/output/bathy/BATHY_LLC30.bin) is real*4;
#   PARM05's readBinaryPrec below (32) controls the bathyFile read
#   explicitly, but set the namelist-wide default to the same value for
#   consistency (no other binary input file in this config needs 64-bit).
 readBinaryPrec=32,
#-- Matches real V4r6's own input.V4r6.102/data: gathers/scatters all
#   mdsio-based I/O (run/ output, pickup files) to/from a single global
#   compact-LLC file per field instead of one file per tile (see
#   HANDOFF.md). The READ side auto-detects whichever format is
#   actually on disk, so this only governs what gets WRITTEN from now
#   on; pre-existing per-tile files must be regenerated.
 useSingleCpuIO=.TRUE.,
 plotLevel=0,
 &

# Elliptic solver parameters
 &PARM02
#-- cg2dMaxIters/cg2dTargetResWunit: adopted real V4r6's convention,
#   confirmed identical between V4r6's own forward and adjoint runs
#   (Time-invariant-adjoint/v4r6/run_local_adjv6_140_noseaicead/data
#   differs from input.V4r6.102/data ONLY in nTimeSteps -- no separate
#   adjoint-specific solver tuning). This DROPS the earlier
#   cg2dTargetResidual=1.E-9 "tighter numerics for AD-gradient
#   agreement" convention this file used to cite (a cs32x15/code_ad
#   template precedent, not a real V4r6 practice).
 cg2dMaxIters=300,
#cg2dTargetResWunit=1.E-12,
 &

# Time stepping parameters
 &PARM03
 nIter0=0,
#-- Phase B: short AD smoke test (same scale as every other code_ad/
#   precedent in this tree, e.g. cs32x15's own nTimeSteps=5).
 nTimeSteps=5,
#-- Unified to V4r6's own deltaT=3600s (2026-11-12), replacing the
#   previously-inherited cs32x15 split (deltaTMom=1200./
#   deltaTtracer=deltaTFreeSurf=deltaTClock=86400.).
 deltaTMom   =3600.,
 deltaTtracer=3600.,
 deltaTFreeSurf=3600.,
 deltaTClock =3600.,
#-- abEps: REMOVED (was 0.1, inherited from cs32x15). abEps is an
#   Adams-Bashforth-2-only parameter (adams_bashforth2.F's
#   abFac=0.5+abEps); this config compiles ALLOW_ADAMSBASHFORTH_3 (same
#   as real V4r6), which uses alph_AB/beta_AB instead -- confirmed via
#   the forward config's runtime config-summary echo that alph_AB/
#   beta_AB were already taking MITgcm's own built-in defaults
#   (0.5 / 5/12, from set_defaults.F) regardless of abEps.
 tracForcingOutAB=1,
#-- Real V4r6 pickup-file cold start (see preprocess/build_llc30_pickup.py
#   and HANDOFF.md's "Pickup-file" section): pickupSuff redirects
#   ini_fields.F's dispatch straight to READ_PICKUP, bypassing the
#   hydrogThetaFile/hydrogSaltFile/pSurfInitFile inline-IC path entirely
#   (PARM05's hydrogThetaFile/hydrogSaltFile below are now unused dead
#   weight, left in place only for provenance -- see that section).
#   pickupStrictlyMatch=.FALSE. matches real V4r6 production's own
#   convention; this pickup supplies every required/needed field
#   (Uvel/Vvel/Theta/Salt/GuNm1/GvNm1/EtaN/dEtaHdt/EtaH) so the
#   strictly-match relaxation is cheap insurance, not relied upon.
 pickupSuff='0000000000',
 pickupStrictlyMatch=.FALSE.,
 pChkptFreq  =1728000.,
 dumpFreq    =622080000.,
#-- monitorFreq=1. is required (not cosmetic): Task 6's "no NaN" check
#   greps STDOUT.0000's per-step monitor output; without an explicit
#   monitorFreq there may be no per-step output to grep at all.
 monitorFreq =1.,
#-- Phase B: needed for the ADM gradient-check STDOUT lines (same
#   precedent as cs32x15/input_ad/data).
 adjMonitorFreq=1.,
 adjDumpFreq=432000.,
#-- periodicExternalForcing/externForcingPeriod/externForcingCycle
#   (cs32x15's PARM03 sets these) are NOT needed here: all surface
#   forcing in this config comes from pkg/exf (see input/data.exf),
#   not from PARM05's built-in periodic-forcing-file mechanism, which
#   is what periodicExternalForcing controls. No PARM05 field below
#   uses it.
 &

# Gridding parameters
 &PARM04
 usingCurvilinearGrid=.TRUE.,
#-- horizGridFile intentionally left UNSET/blank: this makes
#   ini_curvilinear_grid.F read the literal tile001.mitgrid ...
#   tile005.mitgrid files produced by Task 2 (preprocess/output/grid/).
#   Setting horizGridFile to any value switches the expected filename
#   pattern to '<horizGridFile>.face%03d.bin' and additionally requires
#   2 extra fields (AngleCS/AngleSN) that a 16-field mitgrid file does
#   not contain -- confirmed by reading ini_curvilinear_grid.F. Leaving
#   it blank also lets anglesAreSet=.FALSE., so CALC_GRID_ANGLES derives
#   the angles, which is the correct behavior here.
 radius_fromHorizGrid=6370.E3,
#-- Last level extended from cs32x15's original 690. to 1480. (sum
#   5200.->5990.): the real coarsened bathymetry (input/BATHY_LLC30.bin)
#   has wet cells down to -5959.976 m, deeper than the old 5200 m grid
#   bottom -- 353 of 7436 wet cells (4.75%) were being silently clipped
#   to the grid floor. Only the deepest (15th) level changes; levels
#   1-14 are unchanged from the original cs32x15-derived profile.
 delR= 50., 70., 100., 140., 190.,
       240., 290., 340., 390., 440.,
       490., 540., 590., 640., 1480.,
 &

# Input datasets
 &PARM05
 bathyFile      ='BATHY_LLC30.bin',
#-- NOW UNUSED (superseded by PARM03's pickupSuff above, see that
#   comment): real V4r6-derived initial T/S
#   (preprocess/coarsen_initial_ts_to_llc30.py and preprocess/README.md's
#   "Initial condition" section have the provenance/coarsening method),
#   left here uncommented-but-inert only as provenance for where the
#   SAME Theta/Salt data (reused verbatim by
#   preprocess/build_llc30_pickup.py) originally came from -- real*4
#   big-endian, same readBinaryPrec=32 convention as bathyFile above.
#   ini_fields.F's dispatch never reaches INI_THETA/INI_SALT/INI_PSURF
#   once pickupSuff is set, so these two lines would never be read at
#   runtime even if left active -- commented out rather than left as
#   live-looking-but-silently-ignored namelist entries.
#hydrogThetaFile='THETA_LLC30_INIT.bin',
#hydrogSaltFile ='SALT_LLC30_INIT.bin',
 &
