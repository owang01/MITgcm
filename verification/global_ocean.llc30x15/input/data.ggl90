# =====================================================================
# | Parameters for Gaspar et al. (1990)'s TKE vertical mixing scheme  |
# =====================================================================
#-- LLC30 lightweight verification config (Task 4 deviation, not in the
#   plan's original file list): required because useGGL90=.TRUE. in
#   data.pkg makes GGL90_READPARMS call OPEN_COPY_DATA_FILE('data.ggl90',
#   ...), which hard-STOPs ('ABNORMAL END: S/R OPEN_COPY_DATA_FILE') if
#   this file is missing -- confirmed by reading
#   eesupp/src/open_copy_data_file.F. useIDEMIX is left at its default
#   (.FALSE.) so GGL90_PARM02 (IDEMIX) is not read and no extra tidal/
#   wind forcing file is required.
 &GGL90_PARM01
 GGL90diffTKEh=0.E3,
 GGL90ck = 0.1,
 GGL90ceps = 0.7,
 GGL90alpha=30.,
 GGL90m2 = 3.0,
#-- Task 6 fix: GGL90TKEmin=0 fails pkg/ggl90/ggl90_readparms.F's hard
#   check (STOP 'ABNORMAL END: S/R GGL90_READPARMS' if GGL90TKEmin<=0).
#   Use the package's own coded default (1.0d-11, see ggl90_readparms.F)
#   rather than the production v4r6 value (1.e-7), since this is just a
#   numerical floor, not a tuned physics parameter, for this smoke test.
 GGL90TKEmin = 1.E-11,
 GGL90TKEbottom=4.E-6,
 GGL90TKEsurfMin=1.E-4,
 mxlMaxFlag=2,
 GGL90viscMax=1.E2,
 GGL90diffMax=1.E2,
 calcMeanVertShear=.TRUE.,
 GGL90_dirichlet=.FALSE.,
 &
