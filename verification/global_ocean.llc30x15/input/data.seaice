# SEAICE parameters -- real V4r6 values verbatim (Time-invariant-
# adjoint/v4r6/.../run_shelfice_v2_fixed_check/data.seaice), confirmed
# via the real confirmed-stable STIC run. All parameter-only, no file
# dependency -- no AreaFile/HeffFile/etc. needed since the real
# coarsened pickup_seaice.0000000000.* files (preprocess/
# build_llc30_pickup.py) are read automatically via the same
# pickupSuff mechanism the main pickup already uses -- see HANDOFF.md.
 &SEAICE_PARM01

      SEAICE_area_reg = 2.0e-2
      SEAICE_hice_reg = 2.5e-3

      SEAICEpresH0=2.,
      SEAICEpresPow0=1,
      SEAICEpresPow1=1,

      SEAICE_strength = 2.25e4,

      SEAICE_area_max = 1.0,

      SEAICE_no_slip     = .TRUE.,

      SEAICEuseTILT=.FALSE.,

      SEAICE_multDim=1,
      SEAICErestoreUnderIce=.TRUE.,

      SEAICE_salt0=4.,

      LSR_ERROR          = 1.0e-5,

      SEAICEuseDYNAMICS  = .TRUE.,
      MIN_ATEMP          = -40.,
      MIN_TICE           = -40.,
      SEAICEadvScheme    = 33,

      SEAICE_tempFrz0    = -1.96,
      SEAICE_dTempFrz_dS = 0.,
      SEAICEuseMetricTerms = .TRUE.,

      SEAICE_clipVelocities = .FALSE.,

      SEAICEscaleSurfStress = .TRUE.,

      SEAICEaddSnowMass = .TRUE.,

      SEAICE_OLx = 2
      SEAICE_OLy = 2
      SEAICEetaZmethod = 3

      SEAICE_dryIceAlb   = 0.84,
      SEAICE_wetIceAlb   = 0.78,
      SEAICE_drySnowAlb  = 0.90,
      SEAICE_wetSnowAlb  = 0.8 ,
      SEAICE_dryIceAlb_south   = 0.75
      SEAICE_wetIceAlb_south   = 0.66
      SEAICE_drySnowAlb_south  = 0.84
      SEAICE_wetSnowAlb_south  = 0.7
 /
#
 &SEAICE_PARM02
 /
